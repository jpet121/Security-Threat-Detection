tatement_as_compiled":"With same inputs and rule configuration, reproduce substantive findings apart from run-specific metadata.","subject_ref":"T13"},{"id":"P057","interpretation_status":"AWAITING_SEMANTIC_REVIEW","modality":"PROHIBITED","predicate":"redact_credentials","source_anchors":[{"end":9902,"event_id":"S2","excerpt_sha256":"d8713570d83b570deef0c2f5d0faeb9966d2b40b118a70ef09dbf479c9048d69","source_id":"S2","start":9486}],"statement_as_compiled":"Do not expose raw credentials, session tokens or other secrets in ordinary report files and console progress.","subject_ref":"T09"},{"id":"P058","interpretation_status":"AWAITING_SEMANTIC_REVIEW","modality":"REQUIRED","predicate":"redact_excerpts","source_anchors":[{"end":9902,"event_id":"S2","excerpt_sha256":"d8713570d83b570deef0c2f5d0faeb9966d2b40b118a70ef09dbf479c9048d69","source_id":"S2","start":9486}],"statement_as_compiled":"Mask sensitive portions of excerpts while retaining enough detection context for an analyst.","subject_ref":"T09"},{"id":"P059","interpretation_status":"AWAITING_SEMANTIC_REVIEW","modality":"PROHIBITED","predicate":"source_immutable","source_anchors":[{"end":9902,"event_id":"S2","excerpt_sha256":"d8713570d83b570deef0c2f5d0faeb9966d2b40b118a70ef09dbf479c9048d69","source_id":"S2","start":9486}],"statement_as_compiled":"Do not alter or rewrite original input evidence files.","subject_ref":"T09"},{"id":"P060","interpretation_status":"AWAITING_SEMANTIC_REVIEW","modality":"PROHIBITED","predicate":"offline_log_boundary","source_anchors":[{"end":10206,"event_id":"S2","excerpt_sha256":"3c0b65c58d1f9a5a2853161596129e89dd61b13cf096285d1fbcfe3c33aebe63","source_id":"S2","start":9904}],"statement_as_compiled":"Never upload logs or other incident evidence to external services during auditing.","subject_ref":"T09"},{"id":"P061","interpretation_status":"AWAITING_SEMANTIC_REVIEW","modality":"PROHIBITED","predicate":"offline_rules_boundary","source_anchors":[{"end":10206,"event_id":"S2","excerpt_sha256":"3c