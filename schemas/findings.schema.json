{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:security-log-auditor:findings:1",
  "title": "One source event with all classification and rule hits",
  "type": "object",
  "required": ["finding_id", "classification", "classifications", "source_id", "source_path_display_safe", "raw_file_sha256", "line_start", "line_end", "raw_timestamp", "utc_instant", "timestamp_state", "format_id", "fields_redacted", "rule_hits", "safe_excerpt", "review_reasons"],
  "properties": {
    "finding_id": {"type": "string"},
    "classification": {"enum": ["failed_authentication", "suspected_injection"]},
    "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["failed_authentication", "suspected_injection"]}},
    "source_id": {"type": "string", "pattern": "^s[0-9]+$"},
    "source_path_display_safe": {"type": "string"},
    "raw_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "line_start": {"type": "integer", "minimum": 1},
    "line_end": {"type": "integer", "minimum": 1},
    "raw_timestamp": {"type": ["string", "null"]},
    "utc_instant": {"type": ["string", "null"]},
    "timestamp_state": {"type": "string"},
    "format_id": {"enum": ["ssh", "http", "console"]},
    "fields_redacted": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "safe_excerpt": {"type": "string"},
    "review_reasons": {"type": "array", "items": {"type": "string"}},
    "rule_hits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["rule_id", "rule_version", "config_sha256", "classification", "reason", "priority"], "properties": {"config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  },
  "additionalProperties": false
}
